import {signInWithGoogle} from '@/lib/firebase/auth'
import {Icon} from "@/lib/icons";

props {}: {}
setup
  const handleSignin = async () => {
    await signInWithGoogle()
  }
button#cart-button(
  ~ type="button"
  ~ aria-label="sign-in"
  ~ onClick={handleSignin}
  ~ className="group relative flex size-10 shrink-0 items-center justify-center rounded-xl transition-colors hover:bg-mac-blue/5"
  ~ )
  Icon(name='user' size={28})
