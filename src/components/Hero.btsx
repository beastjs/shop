div(className={"flex box-border w-full h-140 max-w-7xl m-auto pt-10 pb-15 justify-between items-center gap-4 text-[rgb(13,_12,_34)] leading-7"})
  div#left-hero(className={"flex box-border w-1/2 h-107.5 p-10 flex-col justify-center rounded-3xl bg-linear-to-b from-[#f4f1eb] to-teal-200/20 text-[rgb(13,_12,_34)]"})
    div(className={"flex w-fit h-9 mb-6 px-4 items-center gap-2 rounded-full bg-white text-[11px] font-bold tracking-[0.12em] uppercase shadow-sm"})
      span(className={"w-2 h-2 rounded-full bg-mac-blue"})
      | THE INDEPENDENT SHOP BUILDER
    section(className={"font-sans flex flex-col items-start gap-6"})
      h1(
        ~ aria-label="Work with the world’s best in design"
        ~ className={"max-w-140 my-0 text-[54px] font-semibold tracking-[-0.045em] leading-[1.08] [font-feature-settings:normal] text-left"}
        ~ )
        | Make your next big idea
        br
        | a beautiful online shop.
      p(className={"max-w-105 my-0 text-[17px] leading-7 text-[#555360]"})
        | Everything you need to bring your products to the world, with a storefront that feels unmistakably yours.
      div(className={"flex min-h-13 flex-wrap items-center gap-4"})
        a(
          ~ href="#"
          ~ className={"flex box-border relative min-w-50 h-13 px-6 justify-center items-center gap-2 text-white text-[14px] font-bold bg-[rgb(13,_12,_34)] rounded-full shadow-[0_10px_24px_rgba(13,_12,_34,_0.16)] transition-transform hover:-translate-y-0.5"}
          ~ )
          | ✦ Build your online shop
        span(className={"text-[13px] font-medium text-[#777481]"})
          | No code needed

  aside(className={"hidden md:flex relative w-153.5 h-107.5 max-w-153.5"})
    button(
      ~ type="button"
      ~ aria-label="Pause media"
      ~ className={"flex absolute top-94.75 right-140 bottom-2.75 left-3.5 z-5 p-0 overflow-x-hidden overflow-y-hidden shrink-0 justify-center items-center gap-2 text-[rgb(13,_12,_34)] [font-family:Mona_Sans,_Helvetica_Neue,_Helvetica,_Arial,_sans-serif] text-[13px] font-semibold leading-3.25 [font-feature-settings:ss01] [white-space-collapse:collapse] [text-wrap-mode:nowrap] bg-[rgb(255,_255,_255)] border-t-[1.5px] border-r-[1.5px] border-b-[1.5px] border-l-[1.5px] [border-top-style:solid] [border-right-style:solid] [border-bottom-style:solid] [border-left-style:solid] [border-top-color:rgb(255,_255,_255)] [border-right-color:rgb(255,_255,_255)] [border-bottom-color:rgb(255,_255,_255)] [border-left-color:rgb(255,_255,_255)] rounded-[50%] shadow-[rgba(6,_3,_24,_0.1)_0px_2px_4px_0px] opacity-[0]"}
      ~ )

    div(className={"flex relative w-153.5 overflow-x-hidden overflow-y-hidden rounded-3xl"})
      img(
        ~ alt="banner"
        ~ width="3132"
        ~ height="901"
        ~ src="https://podpak.me/_next/image?url=https%3A%2F%2Fcdn.shopify.com%2Fs%2Ffiles%2F1%2F0638%2F2760%2F7786%2Ffiles%2Fspotted-podpak-clear_700x.png%3Fv%3D1792606357&amp;w=1920&amp;q=75"
        ~ className={"block box-border w-355.25 h-full max-w-full text-[rgba(0,_0,_0,_0)] align-right [border-top-style:solid] [border-right-style:solid] [border-bottom-style:solid] [border-left-style:solid] [border-top-color:rgb(229,_231,_235)] [border-right-color:rgb(229,_231,_235)] [border-bottom-color:rgb(229,_231,_235)] [border-left-color:rgb(229,_231,_235)] rounded-[20px] [transform-origin:710.5px_200px] object-cover"}
        ~ )
