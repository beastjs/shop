div(className={"mx-auto flex w-full max-w-7xl flex-col gap-6 _px-4 pb-8 _pt-5 md:mt-16 text-[rgb(13,_12,_34)] leading-7 sm:px-6 md:h-140 md:flex-row md:items-center md:justify-between md:gap-4 md:px-8 md:pb-15 md:pt-10"})
