    section(className={"flex flex-col items-start gap-5 font-sans md:gap-6"})
      h1(
        ~ aria-label="Work with the world’s best in design"
        ~ className={"my-0 max-w-[15ch] text-4xl font-semibold tracking-[-0.045em] leading-[1.08] text-left sm:text-5xl md:max-w-140"}
        ~ )
        | Make your next big idea
        br(className="hidden md:block")
        | a beautiful online shop.
      p(className={"my-0 max-w-105 text-[15px] leading-6 text-[#555360] sm:text-base md:text-[17px] md:leading-7"})
        | Everything you need to bring your products to the world, with a storefront that feels unmistakably yours.
      div(className={"flex w-full flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-4"})
        a(
          ~ href="#"
          ~ className={"relative flex min-h-12 w-full box-border items-center justify-center gap-2 rounded-full bg-[rgb(13,_12,_34)] px-5 text-[14px] font-bold text-white shadow-[0_10px_24px_rgba(13,_12,_34,_0.16)] transition-transform hover:-translate-y-0.5 sm:w-fit sm:min-w-50 sm:px-6 md:h-13"}
          ~ )
          | ✦ Build your online shop
        span(className={"text-center text-[13px] font-medium text-[#777481] sm:text-left"})
          | No code needed

