div(className={"mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 pb-8 pt-5 mt-16 text-[rgb(13,_12,_34)] leading-7 sm:px-6 md:h-140 md:flex-row md:items-center md:justify-between md:gap-4 md:px-8 md:pb-15 md:pt-10"})
  div#left-hero(className={"flex min-w-0 w-full flex-col justify-center rounded-3xl bg-linear-to-b from-[#f4f1eb] to-teal-200/20 p-6 text-[rgb(13,_12,_34)] sm:p-8 md:h-107.5 md:w-1/2 md:p-10"})
    div(className={"mb-5 flex min-h-9 w-fit max-w-full items-center gap-2 rounded-full bg-white px-3 text-[10px] font-bold tracking-[0.1em] uppercase shadow-sm sm:text-[11px] md:mb-6 md:px-4"})
      span(className={"w-2 h-2 rounded-full bg-mac-blue"})
