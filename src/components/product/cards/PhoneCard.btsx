import type { ProductCardItem } from '@/lib/product/card-types'
import { toCardModel } from '@/lib/product/card-model'
import { cartActions } from "@/features/cart";
import CardMedia from "./CardMedia.btsx";
import CardLink from "./CardLink.btsx";
import PhotoCredit from "./PhotoCredit.btsx";

// Phones: precise and calm. One soft rounded tile, the device does the talking, type sits below in two tiers.
props {item, priority = false}: { item: ProductCardItem, priority?: boolean }
setup
  const model = toCardModel(item)
  const addToCart = () => cartActions.add(item)
article.product-card(className='group/product relative flex flex-col gap-4 p-2 pb-8 sm:p-3 sm:pb-12')
  CardMedia(model={model} priority={priority} onAdd={addToCart} className='aspect-square rounded-[22px] bg-[#f5f5f7] dark:bg-[#1c1c1e]')
  div(className='flex flex-col gap-0.5 px-1')
    h3(className='m-0 truncate text-[15px] font-medium leading-6 tracking-[-0.015em]')
      CardLink(name={model.productType} className='after:rounded-[22px]')
    p(className='m-0 flex min-w-0 items-baseline gap-1.5 text-[13px] leading-5 text-muted-foreground tabular-nums')
      if model.edition
        fragment
          span(className='shrink-0') #{model.edition}
          span(aria-hidden="true" className='shrink-0 opacity-50') ·
      span(className='shrink-0 text-foreground') #{model.price}
      if model.wasPrice
        span(className='shrink-0 line-through opacity-60') #{model.wasPrice}
    PhotoCredit(credit={model.credit} className='mt-1 text-[10px] leading-4 text-muted-foreground/60')
