import type { ProductCardItem } from '@/lib/product/card-types'
import { toCardModel } from '@/lib/product/card-model'
import { cartActions } from "@/features/cart";
import CardMedia from "./CardMedia.btsx";
import CardLink from "./CardLink.btsx";
import PhotoCredit from "./PhotoCredit.btsx";

props {item, priority = false}: { item: ProductCardItem, priority?: boolean }
setup
  const model = toCardModel(item)
  const addToCart = () => cartActions.add(item)
article.product-card(className='group/product relative flex flex-col gap-3 p-1.5 sm:p-2')
  CardMedia(model={model} priority={priority} onAdd={addToCart} className='aspect-square rounded-lg bg-muted' imgClassName='object-left-top')
    span(className='absolute top-2.5 left-2.5 rounded-full bg-background/90 px-2.5 py-1 text-[10px] font-medium uppercase leading-none tracking-[0.08em] text-foreground') Best seller
  div(className='flex flex-col gap-1 px-0.5')
    div(className='flex items-baseline justify-between gap-3')
      h3(className='min-w-0 truncate text-sm font-normal leading-5 sm:text-[15px]')
        CardLink(name={item.name})
      p(className='flex shrink-0 items-baseline gap-1.5 text-sm leading-5 tabular-nums sm:text-[15px]')
        if model.wasPrice
          span(className='text-xs text-muted-foreground line-through') #{model.wasPrice}
        span #{model.price}
    div(className='flex min-w-0 items-center justify-between gap-3 text-[11px] leading-4 text-muted-foreground')
      span(className='shrink-0 uppercase tracking-[0.08em]') #{model.shortSku}
      PhotoCredit(credit={model.credit})
