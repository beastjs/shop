import type { ProductCardItem } from '@/lib/product/card-types'
import { toCardModel, audioFormFactor } from '@/lib/product/card-model'
import { cartActions } from "@/features/cart";
import CardMedia from "./CardMedia.btsx";
import CardLink from "./CardLink.btsx";
import PhotoCredit from "./PhotoCredit.btsx";

module
  const bars = [0.45, 0.8, 0.6, 1, 0.7, 0.35, 0.9, 0.55]

// Audio: a dark listening-room card, like a record sleeve — the EQ meter wakes up on hover.
props {item, priority = false}: { item: ProductCardItem, priority?: boolean }
setup
  const model = toCardModel(item)
  const form = audioFormFactor(model.productType)
  const addToCart = () => cartActions.add(item)
article.product-card(className='group/product relative m-1.5 flex flex-col gap-3 rounded-2xl bg-[#111214] p-2 text-[#f2f2f0] sm:m-2 sm:p-2.5')
  CardMedia(model={model} priority={priority} onAdd={addToCart} className='aspect-square rounded-xl bg-[#1c1d20]' imgClassName='saturate-[0.85]')
    span(className='absolute top-2.5 left-2.5 rounded-full bg-black/55 px-2.5 py-1 text-[10px] font-medium uppercase leading-none tracking-[0.1em] text-white backdrop-blur-sm') #{form}
  div(className='flex flex-col gap-2 px-1.5 pb-1.5')
    div(className='flex items-center justify-between gap-3')
      span(className='font-mono text-[10px] uppercase leading-none tracking-[0.14em] text-[#8b8d93]') Trk #{model.shortSku}
      div.audio-eq(aria-hidden="true" className='flex h-3 items-end gap-[2px]')
        each level, i in bars key i
          span.audio-eq-bar(className='w-[2px] rounded-full bg-[#ff6a3d]' style={{ height: `${level * 100}%`, animationDelay: `${i * 90}ms` }})
    h3(className='m-0 truncate text-[15px] font-medium leading-4')
      CardLink(sku={item.sku} category='audio' name={item.name} className='after:rounded-2xl')
    div(className='flex items-baseline justify-between gap-3')
      PhotoCredit(credit={model.credit} className='text-[10px] leading-4 text-[#8b8d93]')
      p(className='m-0 font-adin text-base flex items-baseline gap-1.5 leading-5 tabular-nums')
        span #{model.price}
        if model.wasPrice
          span(className='text-xs text-[#8b8d93] line-through') #{model.wasPrice}
