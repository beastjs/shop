import type { ProductCardItem } from '@/lib/product/card-types'
import { toCardModel } from '@/lib/product/card-model'
import { cartActions } from "@/features/cart";
import CardMedia from "./CardMedia.btsx";
import CardLink from "./CardLink.btsx";
import PhotoCredit from "./PhotoCredit.btsx";

// Gaming: HUD panel — notched corners, scanlines, mono caps and a neon edge that powers up on hover.
props {item, priority = false}: { item: ProductCardItem, priority?: boolean }
setup
  const model = toCardModel(item)
  const addToCart = () => cartActions.add(item)
article.product-card.gaming-card(className='group/product relative m-1.5 flex flex-col gap-3 bg-[#0c0d14] p-2 text-[#e8e9f3] sm:m-2 sm:p-2.5')
  CardMedia(model={model} priority={priority} onAdd={addToCart} className='gaming-card-media aspect-square bg-[#161827]')
    span(className='pointer-events-none absolute inset-0 bg-[repeating-linear-gradient(0deg,rgb(0_0_0/0.18)_0_1px,transparent_1px_3px)]')
    span(className='absolute top-2 left-2 bg-[#b6ff3b] px-1.5 py-0.5 font-mono text-[10px] font-bold uppercase leading-none tracking-[0.08em] text-[#0c0d14]') #{'#' + model.shortSku}
    if model.discount
      span(className='absolute top-2 right-2 bg-[#ff3bd4] px-1.5 py-0.5 font-mono text-[10px] font-bold leading-none text-[#0c0d14] tabular-nums') −#{model.discount}%
  div(className='flex flex-col gap-1.5 px-1 pb-1')
    if model.edition
      span(className='font-mono text-[10px] uppercase leading-none tracking-[0.18em] text-[#b6ff3b]') #{model.edition} edition
    h3(className='m-0 truncate font-mono text-[13px] font-semibold uppercase leading-5 tracking-[0.04em]')
      CardLink(name={model.productType} className='after:rounded-none')
    div(className='flex items-baseline justify-between gap-3')
      p(className='m-0 flex items-baseline gap-2 font-mono text-sm font-bold leading-5 tabular-nums')
        span(className='text-[#b6ff3b]') #{model.price}
        if model.wasPrice
          span(className='text-xs font-normal text-[#6e7191] line-through') #{model.wasPrice}
      PhotoCredit(credit={model.credit} className='text-[10px] leading-4 text-[#6e7191]')
