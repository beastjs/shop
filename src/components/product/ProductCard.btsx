import type { ProductCardItem } from '@/lib/product/card-types'
import DefaultCard from "./cards/DefaultCard.btsx";
import ApparelCard from "./cards/ApparelCard.btsx";
import BagsCard from "./cards/BagsCard.btsx";
import PerfumeCard from "./cards/PerfumeCard.btsx";
import PhoneCard from "./cards/PhoneCard.btsx";
import AudioCard from "./cards/AudioCard.btsx";
import GamingCard from "./cards/GamingCard.btsx";
import SoftwareCard from "./cards/SoftwareCard.btsx";

// Each line of commerce gets its own card; all of them share CardMedia's Add to cart button.
props {item, category, priority = false}: { item: ProductCardItem, category?: string, priority?: boolean }
switch category
  case "apparel"
    ApparelCard(item={item} priority={priority})
  case "bags"
    BagsCard(item={item} priority={priority})
  case "perfumes"
    PerfumeCard(item={item} priority={priority})
  case "phones"
    PhoneCard(item={item} priority={priority})
  case "audio"
    AudioCard(item={item} priority={priority})
  case "gaming"
    GamingCard(item={item} priority={priority})
  case "software"
    SoftwareCard(item={item} priority={priority})
  default
    DefaultCard(item={item} priority={priority})
