import { Link } from "@octanejs/tanstack-router";
import type { ProductDetail, ProductDetailCategory } from "@/lib/product/detail-types";
import { toCardModel } from "@/lib/product/card-model";
import { cartActions } from "@/features/cart";
import RunnerButton from "../../ui/RunnerButton.btsx";

module
  type Attribute = ProductDetail['attributes'][number]

  const formatValue = (attribute: Attribute) => {
    const { value, unit } = attribute
    const text = Array.isArray(value) ? value.join(', ') : typeof value === 'boolean' ? (value ? 'Yes' : 'No') : String(value)
    return unit ? `${text} ${unit}` : text
  }

  // Stock wording only claims what the inventory record says.
  const stockLabel = (a: ProductDetail['availability']) => {
    if (!a.tracked) return { text: 'Available', tone: 'ok' as const }
    if (a.available <= 0) return a.allowBackorders ? { text: 'Available on backorder', tone: 'warn' as const } : { text: 'Out of stock', tone: 'out' as const }
    if (a.available <= a.lowStockThreshold) return { text: `Only ${a.available} left`, tone: 'warn' as const }
    return { text: 'In stock', tone: 'ok' as const }
  }

// Product item sidebar: identity → price → stock → Add to cart → details. Sticky beside the gallery on desktop.
props {product, category}: { product: ProductDetail, category: ProductDetailCategory }
setup
  const model = toCardModel(product)
  const stock = stockLabel(product.availability)
  const canBuy = stock.tone !== 'out'
  const addToCart = () => cartActions.add(product)
  const details = [
    ...product.attributes.map(a => ({ id: a.id, label: a.name, value: formatValue(a) })),
    ...(product.brand ? [{ id: 'brand', label: 'Brand', value: product.brand }] : []),
    ...(product.countryOfOrigin ? [{ id: 'origin', label: 'Made in', value: product.countryOfOrigin }] : []),
    ...(product.warrantyInfo ? [{ id: 'warranty', label: 'Warranty', value: product.warrantyInfo }] : []),
    { id: 'sku', label: 'SKU', value: product.sku },
  ]
aside(aria-label="Product details" className='flex flex-col gap-10 px-4 py-8 sm:px-8 lg:sticky lg:top-[var(--topbar-height)] lg:max-h-[calc(100svh-var(--topbar-height))] lg:overflow-y-auto lg:px-10 lg:py-12')
  div(className='flex flex-col gap-5')
    nav(aria-label="Breadcrumb" className='text-[11px] uppercase leading-4 tracking-[0.16em] text-muted-foreground')
      Link(to={'/' + category.slug} className='underline-offset-4 hover:text-foreground hover:underline') #{category.name}
    div(className='flex flex-col gap-3')
      h1(className='m-0 text-[26px] font-medium leading-[1.15] tracking-[-0.02em] text-balance sm:text-3xl') #{product.name}
      if product.shortDescription
        p(className='m-0 text-[15px] leading-6 text-muted-foreground text-pretty') #{product.shortDescription}
    div(className='flex items-center justify-between')
      div(className='flex items-baseline gap-3 tabular-nums')
        p(className='text-xl leading-7') #{model.price}
        if model.wasPrice
          fragment
            span(className='text-sm text-muted-foreground line-through') #{model.wasPrice}
            span(className='text-sm text-muted-foreground') −#{model.discount}%
      p(className='m-0 flex items-center gap-2 text-[13px] leading-5')
        span(aria-hidden="true" className={stock.tone === 'ok' ? 'size-1.5 rounded-full bg-positive' : stock.tone === 'warn' ? 'size-1.5 rounded-full bg-warning' : 'size-1.5 rounded-full bg-muted-foreground'})
        | #{stock.text}

  div(className='flex flex-col gap-3')

    if canBuy
      RunnerButton(className='w-full bg-foreground! text-white!' label='Add to cart' paint={'var(--mac-blue)'} onClick={addToCart})
    else
      p(className='m-0 flex h-11 items-center justify-center rounded-lg border border-border text-sm text-muted-foreground') Currently unavailable
  section(aria-labelledby="product-description" className='flex flex-col gap-3 border-t border-border pt-8')
    h2#product-description(className='m-0 text-[11px] font-normal uppercase leading-4 tracking-[0.16em] text-muted-foreground') Description
    p(className='m-0 text-[15px] leading-7 text-pretty') #{product.description}
  section(aria-labelledby="product-specs" className='flex flex-col gap-3 border-t border-border pt-8')
    h2#product-specs(className='m-0 text-[11px] font-normal uppercase leading-4 tracking-[0.16em] text-muted-foreground') Details
    if !product.price.isTaxInclusive
      span(className='-mt-3 text-[11px] leading-4 text-muted-foreground') Taxes calculated at checkout
    dl(className='m-0 grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-x-6 gap-y-2.5 text-[13px] leading-5')
      each row in details key row.id
        fragment
          dt(className='text-muted-foreground') #{row.label}
          dd(className='m-0 break-words') #{row.value}
