import type { ProductMedia } from "@/lib/product/types";
import { previewSrc, PREVIEW_WIDTH } from "@/lib/product/gallery";
import { photoCredit } from "@/lib/product/card-model";
import PhotoCredit from "./cards/PhotoCredit.btsx";

// The one large image. Every photo is stacked and preloaded so switching on hover is instant;
// only the active one is visible, with a short crossfade. Under the main sharp photo sits the card's
// own 400px copy (already in the browser cache from the list), so something paints on frame one
// even when the hover prefetch didn't happen (touch, direct link).
props {images, active, name}: { images: ProductMedia[], active: number, name: string }
setup
  // Credit always names the photographer of the photo on screen, not just the primary one.
  const credit = photoCredit(images[active])
figure(className='relative m-0 aspect-[4/5] w-full overflow-hidden bg-[#f4f3f1] lg:aspect-auto lg:h-[calc(100svh-var(--topbar-height)-4rem)] dark:bg-[#1d1d1c]')
  each image, index in images key image.id
    span(aria-hidden={index !== active} className={`absolute inset-0 transition-opacity duration-200 ease-out motion-reduce:transition-none ${index === active ? 'opacity-100' : 'opacity-0'}`})
      // Only the primary photo has a cached card-size copy; the others are preloaded sharp on hover.
      if index === 0
        img(
          ~ src={image.url}
          ~ alt=""
          ~ aria-hidden="true"
          ~ decoding="async"
          ~ className='absolute inset-0 block h-full w-full scale-[1.02] object-cover blur-[2px]'
          ~ )
      img(
        ~ src={previewSrc(image.url)}
        ~ alt={index === active ? (image.altText ?? name) : ''}
        ~ width={PREVIEW_WIDTH}
        ~ height={PREVIEW_WIDTH * 1.25}
        ~ loading={index === 0 ? 'eager' : 'lazy'}
        ~ fetchPriority={index === 0 ? 'high' : 'auto'}
        ~ decoding="async"
        ~ className='absolute inset-0 block h-full w-full object-cover'
        ~ )
  if credit
    div(className='absolute bottom-3 left-3 max-w-[calc(100%-1.5rem)] rounded-full bg-background/80 px-3 py-1.5 text-[11px] leading-4 text-muted-foreground backdrop-blur-sm')
      PhotoCredit(credit={credit})
