    div(className={"hidden fixed top-0 left-0 z-110 w-364 h-225.5 bg-[rgba(0,_0,_0,_0.4)] [border-top-style:solid] [border-right-style:solid] [border-bottom-style:solid] [border-left-style:solid] [border-top-color:rgb(229,_231,_235)] [border-right-color:rgb(229,_231,_235)] [border-bottom-color:rgb(229,_231,_235)] [border-left-color:rgb(229,_231,_235)]"})
    div(className={"flex fixed top-0 right-248.25 bottom-0 left-0 z-115 max-w-112 max-h-225.5 flex-col bg-[rgb(255,_255,_255)] [border-top-style:solid] [border-right-style:solid] [border-bottom-style:solid] [border-left-style:solid] [border-top-color:rgb(229,_231,_235)] [border-right-color:rgb(229,_231,_235)] [border-bottom-color:rgb(229,_231,_235)] [border-left-color:rgb(229,_231,_235)] [transform:matrix(1,_0,_0,_1,_-448,_0)]"})
      div(className={"flex w-112 h-15.25 py-4 px-5 justify-between items-center border-b-1 [border-top-style:solid] [border-right-style:solid] [border-bottom-style:solid] [border-left-style:solid] [border-top-color:rgb(229,_231,_235)] [border-right-color:rgb(229,_231,_235)] [border-bottom-color:rgb(211,_210,_208)] [border-left-color:rgb(229,_231,_235)]"})
        h5(className={"w-10.9961 h-7 my-0 text-[20px] leading-7 [border-top-style:solid] [border-right-style:solid] [border-bottom-style:solid] [border-left-style:solid] [border-top-color:rgb(229,_231,_235)] [border-right-color:rgb(229,_231,_235)] [border-bottom-color:rgb(229,_231,_235)] [border-left-color:rgb(229,_231,_235)]"}) filter
