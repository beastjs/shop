import Hero from "../components/Hero.btsx";
import SearchBar from "../components/SearchBar.btsx";
import { productCategories } from "../lib/product/categories";
import { Link } from "@octanejs/tanstack-router";

props {}:{}

fragment
  Hero
  SearchBar
  section(className="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 sm:py-12 md:px-10")
    header(className="mb-6 sm:mb-7")
      p(className="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500") Browse the shop
      h2(className="m-0 text-2xl font-semibold tracking-tight sm:text-3xl") Shop by category
    div(className="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3")
      each category, index in productCategories key category.slug
        Link(
          ~ to={'/' + category.slug}
          ~ className="group relative flex min-h-36 flex-col justify-between overflow-hidden rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 sm:min-h-44 sm:p-6"
          ~ )
          span(className="absolute -right-5 -top-6 text-8xl font-semibold leading-none text-neutral-100 transition-colors group-hover:text-blue-50 sm:-right-7 sm:-top-10 sm:text-[150px]") #{String(index + 1).padStart(2, '0')}
          div(className="relative z-1 flex h-full flex-col justify-between")
            span(className="text-xs font-semibold uppercase tracking-[0.16em] text-neutral-400") Explore
            div(className="flex items-end justify-between gap-4")
              h3(className="m-0 text-lg font-semibold tracking-tight sm:text-2xl") #{category.name}
              span(aria-hidden="true" className="mb-1 text-xl transition-transform group-hover:translate-x-1") →
