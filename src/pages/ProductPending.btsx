props {}:{}

div(className='grid w-full lg:grid-cols-[minmax(0,1fr)_minmax(380px,480px)]' aria-busy="true" aria-label="Loading product")
  div(className='grid grid-cols-1 gap-px sm:grid-cols-2')
    each slot in [0, 1] key slot
      div(className='aspect-square bg-neutral-200/70 animate-pulse')
  div(className='flex flex-col gap-5 px-4 py-8 sm:px-8 lg:px-10 lg:py-12')
    div(className='h-3 w-20 rounded bg-neutral-200/70 animate-pulse')
    div(className='h-8 w-3/4 rounded bg-neutral-200/70 animate-pulse')
    div(className='h-6 w-24 rounded bg-neutral-200/70 animate-pulse')
    div(className='mt-6 h-11 w-full rounded-lg bg-neutral-200/70 animate-pulse')
