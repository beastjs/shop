// Generated by @beastjs/auth as a starting point. Yours to edit.
import { Link, Outlet } from '@octanejs/tanstack-router'
import { buildAppUrl } from '@/lib/routing/app-url'
import { isAdminSubdomainHostname, adminRoutePrefix } from '@/lib/routing/admin-console'
import '@/styles/admin.css'

setup
  // The console's pages are the same on both hosts: its own subdomain roots them
  // at `/`, while the main origin roots them under `/admin`, so links have
  // to be built rather than written out.
  const base =
    typeof window !== 'undefined' && !isAdminSubdomainHostname(window.location.hostname)
      ? adminRoutePrefix
      : ''

  const overviewPath = base.length > 0 ? base : '/'

  const homeUrl = typeof window === 'undefined' ? '/' : buildAppUrl(new URL(window.location.href), '/').toString()

main(className='admin-frame')
  aside(className='admin-sidebar')
    a(className='admin-brand' href={homeUrl})
      span(className='admin-brand-mark') A
      span(className='admin-brand-name') Admin
    nav(className='admin-nav' aria-label='Admin')
      Link(className='admin-nav-link' to={overviewPath}) Overview
    p(className='admin-sidebar-foot') Back to the app

  section(className='admin-content')
    div(className='admin-gate' role='status')
      strong Open to everyone.
      span No `admin` session is checked on this console yet.
    Outlet
