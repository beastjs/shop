import { Link, useLoaderData } from "@octanejs/tanstack-router";
import type { ProductDetailResult } from "../lib/product/detail-types";
import ProductPreview from "../components/product/ProductPreview.btsx";
import ProductSidebar from "../components/product/ProductSidebar.btsx";

// Product item page: gallery fills the left, details sidebar sits sticky on the right (stacked on phones).
setup
  const result = useLoaderData({ strict: false }) as ProductDetailResult
if result
  div(className='grid w-full lg:grid-cols-[minmax(0,1fr)_minmax(380px,480px)] lg:items-start')
    ProductPreview(media={result.product.media} name={result.product.name})
    ProductSidebar(product={result.product} category={result.category})
else
  section(className='flex min-h-[60svh] flex-col items-center justify-center gap-4 px-4 text-center')
    h1(className='m-0 text-2xl font-medium tracking-tight') Product not found
    p(className='m-0 text-muted-foreground') This item isn't available, or the link is out of date.
    Link(to="/" className='text-sm underline underline-offset-4') Back to the shop
