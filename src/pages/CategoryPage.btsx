import ProductGrid from "../components/product/ProductGrid.btsx";
import ProductFooter from "../components/product/ProductFooter.btsx";
import { useLoaderData } from "@octanejs/tanstack-router";
import type { CategoryProductsResult } from "../lib/product/card-types";
import SearchBar from "../components/SearchBar.btsx";
import { useEffect, useMemo, useState } from "octane";
import Lenis from "lenis";
import "lenis/dist/lenis.css";
import { filterProducts } from "../lib/product/search";

setup
  const { category, products } = useLoaderData({ strict: false }) as CategoryProductsResult
  const [query, setQuery] = useState("")

  // Smooth window scrolling while this page is mounted; skipped for reduced-motion users.
  useEffect(() => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const lenis = new Lenis({ autoRaf: true, lerp: 0.08, anchors: true })
    return () => lenis.destroy()
  })
  const filteredProducts = useMemo(() => filterProducts(products, query))
  const productGridProps = { products: filteredProducts }

section(className="w-full overflow-x-clip py-6 sm:py-10")
  header(className="my-4 flex flex-col items-stretch gap-4 px-4 sm:my-8 sm:flex-row sm:items-center sm:justify-between sm:gap-8")
    h1(className="m-0 text-3xl font-semibold tracking-tight sm:text-4xl") #{category?.name ?? "Category not found"}
    SearchBar(className="px-0 sm:max-w-3xl sm:px-0 md:px-0" placeholder={`Search ${category?.slug} by name or price`} onSearch={setQuery})
  if category
    if products.length > 0
      if filteredProducts.length > 0
        fragment
          ProductGrid({...productGridProps})
          ProductFooter
      else
        p(className="px-4 text-base text-neutral-600") No products match “#{query}”.
    else
      p(className="text-base text-neutral-600") Products in this category are coming soon.
  else
    p(className="text-base text-neutral-600") We couldn't find that category.
