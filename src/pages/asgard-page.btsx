// Generated by @beastjs/auth as a starting point. Yours to edit.
import { Outlet, useRouterState } from '@octanejs/tanstack-router'
import { useState } from 'octane'
import { Group, Panel, Separator, usePanelRef } from '@octanejs/resizable-panels'
import AsgardSidebar from '@/components/asgard/AsgardSidebar.btsx'
import { buildAppUrl } from '@/lib/routing/app-url'
import { isAsgardSubdomainHostname, asgardRoutePrefix } from '@/lib/routing/asgard-console'
import '@/styles/asgard.css'

setup
  // The console's pages are the same on both hosts: its own subdomain roots them
  // at `/`, while the main origin roots them under `/asgard`, so links have
  // to be built rather than written out.
  const base =
    typeof window !== 'undefined' && !isAsgardSubdomainHostname(window.location.hostname)
      ? asgardRoutePrefix
      : ''

  const overviewPath = base.length > 0 ? base : '/'

  const homeUrl = typeof window === 'undefined' ? '/' : buildAppUrl(new URL(window.location.href), '/').toString()
  const path = useRouterState({ select: state => state.location.pathname })
  const sidebarPanelRef = usePanelRef()
  const [isCompact, setIsCompact] = useState(false)
  const navigationItems = [{ to: overviewPath, label: 'Overview', icon: 'asgard', exact: true }]

  const toggleSidebar = () => {
    const panel = sidebarPanelRef.current
    if (!panel) return

    if (panel.isCollapsed()) panel.expand()
    else panel.collapse()
  }

Group(
  ~ id='asgard-layout'
  ~ className='asgard-frame'
  ~ defaultLayout={{ sidebar: 22, content: 78 }}
  ~ )
  Panel(
    ~ id='sidebar'
    ~ panelRef={sidebarPanelRef}
    ~ minSize='14rem'
    ~ maxSize='24rem'
    ~ collapsedSize='4.25rem'
    ~ collapsible={true}
    ~ onResize={(size) => setIsCompact(size.inPixels <= 100)}
    ~ className='asgard-sidebar-panel'
    ~ )
    AsgardSidebar(
      ~ path={path}
      ~ items={navigationItems}
      ~ isCompact={isCompact}
      ~ toggleSidebar={toggleSidebar}
      ~ homeUrl={homeUrl}
      ~ )

  Separator(id='asgard-sidebar-resize' className='asgard-resize-handle' aria-label='Resize Asgard navigation')

  Panel(id='content' className='asgard-content-panel')
    section(className='asgard-content')
      div(className='asgard-gate' role='status')
        strong Open to everyone.
        span No `god` session is checked on this console yet.
      Outlet
