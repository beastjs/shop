// Generated by @beastjs/auth as a starting point. Yours to edit.
import { Outlet, useRouterState } from '@octanejs/tanstack-router'
import { useEffect, useState } from 'octane'
import { Group, Panel, Separator, usePanelRef, type PanelSize } from '@octanejs/resizable-panels'
import { signOut } from 'firebase/auth'
import AsgardSidebar, { NavItem } from '@/components/asgard/AsgardSidebar.btsx'
import { auth } from '@/lib/firebase'
import { useFirebaseUser } from '@/lib/firebase/auth'
import { signInFromConsoleSession } from '@/lib/firebase/console-session'
import { buildAppUrl } from '@/lib/routing/app-url'
import { isAsgardConsoleHostname, isAsgardSubdomainHostname, asgardRoutePrefix } from '@/lib/routing/asgard-console'
import '@/styles/asgard.css'

module
  const COMPACT_AT_PX = 90


setup
  // The console's pages are the same on both hosts: its own subdomain roots them
  // at `/`, while the main origin roots them under `/asgard`, so links have
  // to be built rather than written out.
  const base =
    typeof window !== 'undefined' && !isAsgardSubdomainHostname(window.location.hostname)
      ? asgardRoutePrefix
      : ''

  const overviewPath = base.length > 0 ? base : '/'
  const accountsPath = `${base}/accounts`

  const homeUrl = typeof window === 'undefined' ? '/' : buildAppUrl(new URL(window.location.href), '/').toString()
  const path = useRouterState({ select: state => state.location.pathname })
  const sidebarPanelRef = usePanelRef()
  const [isCompact, setIsCompact] = useState(true)
  const navigationItems: NavItem[] = [
    { to: overviewPath, label: 'Overview', icon: 'menu', exact: true },
    { to: accountsPath, label: 'Accounts', icon: 'user' }
  ]

  const { hasGodAccess, isLoading: isAuthLoading, user } = useFirebaseUser()
  const [email, setEmail] = useState<string | null>(null)
  const [sessionStatus, setSessionStatus] = useState<'loading' | 'ready' | 'unauthorized' | 'error'>('loading')
  const isAsgardHost = typeof window !== 'undefined' && isAsgardConsoleHostname(window.location.hostname)

  useEffect(() => {
    let cancelled = false

    const fail = (status: 'unauthorized' | 'error') => {
      if (!cancelled) setSessionStatus(status)
    }

    const openAsgard = async () => {
      if (!isAsgardHost) {
        fail('unauthorized')
        return
      }

      const idToken = new URLSearchParams(window.location.hash.slice(1)).get('idToken')

      try {
        let response: Response
        if (idToken) {
          response = await fetch('/api/asgard/session', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ idToken })
          })

          if (!response.ok) {
            fail('unauthorized')
            return
          }

          window.history.replaceState(null, '', `${window.location.pathname}${window.location.search}`)
        }

        response = await fetch('/api/asgard/session', { credentials: 'same-origin', cache: 'no-store' })

        if (!response.ok && user && hasGodAccess) {
          const freshIdToken = await user.getIdToken(true)
          response = await fetch('/api/asgard/session', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ idToken: freshIdToken })
          })
          if (response.ok) {
            response = await fetch('/api/asgard/session', { credentials: 'same-origin', cache: 'no-store' })
          }
        }

        if (!response.ok) {
          if (isAuthLoading) return
          fail(response.status === 503 ? 'error' : 'unauthorized')
          return
        }

        const payload: unknown = await response.json()
        const verifiedUid =
          typeof payload === 'object' && payload !== null && typeof (payload as { uid?: unknown }).uid === 'string'
            ? (payload as { uid: string }).uid
            : null
        const verifiedEmail =
          typeof payload === 'object' && payload !== null && typeof (payload as { email?: unknown }).email === 'string'
            ? (payload as { email: string }).email
            : null

        if (!verifiedUid) {
          fail('error')
          return
        }

        if (auth?.currentUser && auth.currentUser.uid !== verifiedUid) await signOut(auth)
        else if (auth?.currentUser) await auth.currentUser.getIdToken(true)
        if (!(await signInFromConsoleSession('asgard'))) {
          fail('unauthorized')
          return
        }

        if (!cancelled) {
          setEmail(verifiedEmail)
          setSessionStatus('ready')
        }
      } catch {
        fail('error')
      }
    }

    void openAsgard()
    return () => {
      cancelled = true
    }
  }, [hasGodAccess, isAuthLoading, isAsgardHost, user])

  const handleSidebarResize = (size: PanelSize) => setIsCompact(size.inPixels <= COMPACT_AT_PX)

  const toggleSidebar = () => {
    const panel = sidebarPanelRef.current
    if (!panel) return

    if (panel.isCollapsed()) panel.expand()
    else panel.collapse()
  }

Group(
  ~ id='asgard-layout'
  ~ className='asgard-frame'
  ~ defaultLayout={{ sidebar: 22, content: 78 }}
  ~ )
  Panel(
    ~ id='sidebar'
    ~ panelRef={sidebarPanelRef}
    ~ minSize='14rem'
    ~ maxSize='24rem'
    ~ collapsedSize='4.25rem'
    ~ collapsible={true}
    ~ onResize={handleSidebarResize}
    ~ className='asgard-sidebar-panel'
    ~ )
    AsgardSidebar(
      ~ path={path}
      ~ items={navigationItems}
      ~ isCompact={isCompact}
      ~ toggleSidebar={toggleSidebar}
      ~ homeUrl={homeUrl}
      ~ identity={email}
      ~ )

  Separator(id='asgard-sidebar-resize' className='asgard-resize-handle' aria-label='Resize Asgard navigation')

  Panel(id='content' className='asgard-content-panel')
    section(className='asgard-content')
      if sessionStatus === 'loading'
        div(className='asgard-session-state' role='status')
          p Verifying your administrator session…
      elseif sessionStatus === 'ready'
        Outlet
      elseif sessionStatus === 'unauthorized'
        div(className='asgard-session-state' role='status')
          p You do not have an active god session.
          a(href={homeUrl}) Return to the app
      else
        div(className='asgard-session-state' role='status')
          p We could not verify your god session. Please try again.
