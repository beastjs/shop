import { Link } from "@octanejs/tanstack-router";
import type { CartSuggestions } from "./cart-suggestions";
import { toCardModel } from "@/lib/product/card-model";
import { Icon } from "@/lib/icons";
import { cartActions } from "../index";

module
  type Suggestion = CartSuggestions["byCategory"][number]

// One compact row in the empty cart: photo + name + price open the product page (and close the
// drawer); the round button adds it straight to the cart.
props {item}: { item: Suggestion }
setup
  const model = toCardModel(item)
  const href = `/${item.category.slug}/${encodeURIComponent(item.sku)}`
li(className='relative flex items-center gap-4 py-3')
  div(className='h-20 w-16 shrink-0 overflow-hidden rounded-md bg-[#f4f3f1] dark:bg-[#1d1d1c]')
    if model.image
      img(src={model.image.url} alt="" width={64} height={80} loading="lazy" decoding="async" className='block h-full w-full object-cover')
  div(className='flex min-w-0 flex-1 flex-col gap-0.5')
    span(className='font-[450] text-muted-foreground text-[10px] uppercase leading-4 tracking-[0.14em]') #{item.category.name}
    // Stretched link: the whole row opens the product, except the add button above it.
    Link(to={href} onClick={cartActions.close} className='truncate text-sm leading-5 outline-none after:absolute after:inset-0 after:rounded-md focus-visible:after:ring-2 focus-visible:after:ring-ring') #{item.name}
    span(className='flex items-baseline gap-1.5 font-adin text-sm leading-5 tabular-nums')
      span #{model.price}
      if model.wasPrice
        span(className='text-xs text-muted-foreground line-through') #{model.wasPrice}
  button(
    ~ type="button"
    ~ aria-label={`Add ${item.name} to cart`}
    ~ onClick={() => cartActions.add(item)}
    ~ className='relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full border border-border transition-colors hover:bg-foreground hover:text-background focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring active:scale-95'
    ~ )
    Icon(name="plus" className='size-3.5')
