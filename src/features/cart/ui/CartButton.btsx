import { Icon } from "@/lib/icons";
import { cartActions, cartCount$ } from "../index";
import { useSignal } from "./useSignal";

props {}:{}
setup
  const count = useSignal(cartCount$)
button#cart-button(
  ~ type="button"
  ~ aria-label={count > 0 ? `Open cart, ${count} item${count === 1 ? "" : "s"}` : "Open cart"}
  ~ aria-haspopup="dialog"
  ~ onClick={cartActions.toggle}
  ~ className="relative flex items-center justify-center size-10 rounded-full hover:bg-foreground/5 transition-colors"
  ~ )
  Icon(name="bag")
  if count > 0
    span(aria-hidden="true" className="absolute -top-0.5 -right-0.5 min-w-5 h-5 px-1 flex items-center justify-center rounded-full bg-mac-blue text-white text-[11px] font-semibold leading-none") #{count > 99 ? "99+" : count}
