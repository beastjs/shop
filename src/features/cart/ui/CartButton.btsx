import { Icon } from "@/lib/icons";
import { cartActions, cartCount$ } from "../index";
import { useSignal } from "./useSignal";

props {}:{}
setup
  const count = useSignal(cartCount$)
button#cart-button(
  ~ type="button"
  ~ aria-label={count > 0 ? `Open cart, ${count} item${count === 1 ? "" : "s"}` : "Open cart"}
  ~ aria-haspopup="dialog"
  ~ onClick={cartActions.toggle}
  ~ className="relative flex items-center justify-center size-10 rounded-full hover:bg-foreground/5 transition-colors"
  ~ )
  Icon(name="bag" size={24})
  if count > 0
    span(aria-hidden="true" className="absolute bottom-0.75 right-0 min-h-4.5 min-w-4.5 aspect-square flex items-center justify-center rounded-lg bg-mac-blue text-white text-[12px] font-[550] leading-none tracking-tighter") #{count > 99 ? "99+" : count}
