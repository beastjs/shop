import { Icon } from "@/lib/icons";
import { cartActions, cartCount$ } from "../index";
import { useSignal } from "./useSignal";
import {useState} from 'octane'

props {}:{}
setup
  const count = useSignal(cartCount$)
  const [isHovered, setIsHovered] = useState(false)
  const handleMouseOver = (hover: boolean) => () => void setIsHovered(hover)
button#cart-button(
  ~ type="button"
  ~ aria-label={count > 0 ? `Open cart, ${count} item${count === 1 ? "" : "s"}` : "Open cart"}
  ~ aria-haspopup="dialog"
  ~ onMouseEnter={handleMouseOver(true)}
  ~ onMouseLeave={handleMouseOver(false)}
  ~ onClick={cartActions.toggle}
  ~ className="group relative flex items-center justify-center size-10 rounded-xl hover:text-[#fff] hover:bg-mac-blue/5 transition-colors"
  ~ )
  Icon(name={isHovered ? 'bag-fill':'bag'} size={26} className={isHovered ? 'text-mac-blue' : 'text-foreground/90'})
  if count > 0
    span(aria-hidden="true" className="absolute bottom-2.25 right-2.75 min-h-4.5 min-w-4.5 aspect-square flex items-center justify-center rounded-lg font-ark font-bold text-foreground/80 group-hover:text-[#fff] text-[12px] leading-none tracking-wide") #{count > 99 ? "99+" : count}
