import { useState } from "octane";
import { Icon } from "@/lib/icons";
import Drawer, { DrawerClose } from "@/ui/Drawer.btsx";
import { cartActions, cartDrawerOpen$, cartState$, cartTotals$, formatMoney, lineKey } from "../index";
import CartLineItem from "./CartLineItem.btsx";
import { useSignal } from "./useSignal";

props {}:{}
setup
  const open = useSignal(cartDrawerOpen$)
  const { cart, sync, error, adjustments } = useSignal(cartState$)
  const totals = useSignal(cartTotals$)
  const [checkoutMessage, setCheckoutMessage] = useState<string | null>(null)

  const checkout = async () => {
    setCheckoutMessage(null)
    const result = await cartActions.checkout()
    if ("url" in result) window.location.assign(result.url)
    else setCheckoutMessage(result.message)
  }

// Base UI owns the portal, focus trap, Escape, outside click and focus return.
// The Topbar sits at z-100, so the drawer layers above it.
Drawer(
  ~ title="Your cart"
  ~ open={open}
  ~ onOpenChange={(next: boolean) => (next ? cartActions.open() : cartActions.close())}
  ~ swipeToOpen={false}
  ~ className="w-[min(28rem,100vw)]"
  ~ backdropClassName="z-[150]"
  ~ viewportClassName="z-[160]"
  ~ )
  div(className="flex min-h-0 flex-1 flex-col")
    header(className="flex items-center justify-between px-6 h-16 shrink-0 border-b border-border")
      h2(aria-hidden="true" className="text-lg font-semibold") Your cart
      DrawerClose(type="button" aria-label="Close cart" className="flex size-9 items-center justify-center rounded-full hover:bg-foreground/5")
        Icon(name="close")
    if adjustments.length > 0
      div(role="status" className="mx-6 mt-4 rounded-md bg-amber-50 p-3 text-sm text-amber-900")
        ul(className="space-y-1")
          each note, index in adjustments key index
            li #{note.message}
        button(type="button" onClick={cartActions.dismissAdjustments} className="mt-2 underline") Dismiss
    if cart.lines.length === 0
      div(className="flex flex-1 flex-col items-center justify-center gap-2 px-6 text-center")
        p(className="text-lg font-medium") Your cart is empty
        p(className="text-sm opacity-60") Add something you like and it will show up here.
    else
      fragment
        ul(data-lenis-prevent="" className="min-h-0 flex-1 overflow-y-auto overscroll-contain px-3 divide-y divide-border/50")
          each line in cart.lines key lineKey(line.productId, line.variantId)
            CartLineItem(line={line})
        footer(className="shrink-0 border-t border-border px-6 py-5 space-y-3")
          div(className="flex items-center justify-between text-base")
            span Subtotal
            span(className="font-semibold tabular-nums") #{formatMoney(totals.subtotal)}
          p(className="text-xs opacity-60") Taxes and shipping are calculated at checkout.
          if sync === "error"
            p(role="alert" className="text-sm text-red-600")
              | Couldn't reach the store: #{error}.
              button(type="button" onClick={cartActions.retrySync} className="ml-1 underline") Retry
          elseif sync === "syncing" || sync === "pending"
            p(aria-live="polite" className="text-xs opacity-60") Checking prices and stock…
          button(type="button" onClick={checkout} className="flex h-12 w-full items-center justify-center rounded-md bg-foreground text-background font-semibold hover:opacity-90") Checkout
          if checkoutMessage
            p(role="status" className="text-center text-sm opacity-70") #{checkoutMessage}
