import { useEffect, useState } from "octane";
import { Icon } from "@/lib/icons";
import Drawer, { DrawerClose } from "@/ui/Drawer.btsx";
import { cartActions, cartDrawerOpen$, cartState$, cartTotals$, formatMoney, lineKey } from "../index";
import CartLineItem from "./CartLineItem.btsx";
import CartSuggestion from "./CartSuggestion.btsx";
import { loadCartSuggestions, type CartSuggestions } from "./cart-suggestions";
import { useSignal } from "./useSignal";
import RunnerButton from "../../../ui/RunnerButton.btsx";

props {}:{}
setup
  const open = useSignal(cartDrawerOpen$)
  const { cart, sync, error, adjustments } = useSignal(cartState$)
  const totals = useSignal(cartTotals$)
  // Fetched the first time the drawer opens empty, then reused for the session.
  const [suggestions, setSuggestions] = useState<CartSuggestions | null>(null)
  const isEmpty = cart.lines.length === 0
  useEffect(() => {
    if (!open || !isEmpty || suggestions) return
    let cancelled = false
    loadCartSuggestions().then((result) => {
      if (!cancelled && result) setSuggestions(result)
    })
    return () => {
      cancelled = true
    }
  }, [open, isEmpty, suggestions])
  const hasSuggestions = !!suggestions && (suggestions.featured.length > 0 || suggestions.byCategory.length > 0)
  const [checkoutMessage, setCheckoutMessage] = useState<string | null>(null)

  const checkout = async () => {
    setCheckoutMessage(null)
    const result = await cartActions.checkout()
    if ("url" in result) window.location.assign(result.url)
    else setCheckoutMessage(result.message)
  }

// Base UI owns the portal, focus trap, Escape, outside click and focus return.
// The Topbar sits at z-100, so the drawer layers above it.
Drawer(
  ~ title="Your cart"
  ~ open={open}
  ~ onOpenChange={(next: boolean) => (next ? cartActions.open() : cartActions.close())}
  ~ swipeToOpen={false}
  ~ className="w-[min(28rem,100vw)]"
  ~ backdropClassName="z-[150]"
  ~ viewportClassName="z-[160]"
  ~ )
  div(className="flex min-h-0 flex-1 flex-col")
    header(className="flex items-center justify-between px-6 h-16 shrink-0 bg-foreground/4")
      h2(aria-hidden="true" className="font-apro text-lg")
        span Your cart
        if cart.lines.length === 0
          span(className='px-2') is empty
      DrawerClose(type="button" aria-label="Close cart" className="flex size-9 items-center justify-center rounded-full hover:bg-foreground/5")
        Icon(name="close")
    if adjustments.length > 0
      div(role="status" className="mx-6 mt-0 rounded-md bg-amber-50 p-3 text-sm text-amber-900")
        ul(className="space-y-1")
          each note, index in adjustments key index
            li #{note.message}
        button(type="button" onClick={cartActions.dismissAdjustments} className="mt-2 underline") Dismiss
    if cart.lines.length === 0
      if hasSuggestions
        div(data-lenis-prevent="" className="min-h-0 flex-1 overflow-y-auto overscroll-contain px-6 pb-8")
          div(className="flex flex-col gap-1 py-4")
            p(className="m-0 font-adin text-sm text-foreground uppercase") Here are a few things to start with.
          if suggestions!.featured.length > 0
            section(aria-labelledby="cart-featured" className="pb-6")
              h3#cart-featured(className="m-0 text-[11px] font-normal uppercase leading-4 tracking-[0.16em] text-muted-foreground") Featured
              ul(className="m-0 list-none divide-y divide-border/60 p-0")
                each item in suggestions!.featured key item.id
                  CartSuggestion(item={item})
          if suggestions!.byCategory.length > 0
            section(aria-labelledby="cart-categories")
              h3#cart-categories(className="m-0 text-[11px] font-normal uppercase leading-4 tracking-[0.16em] text-muted-foreground") One from each category
              ul(className="m-0 list-none divide-y divide-border/60 p-0")
                each item in suggestions!.byCategory key item.id
                  CartSuggestion(item={item})
      else
        div(className="flex flex-1 flex-col items-center justify-center gap-2 px-6 text-center")
          p(className="text-lg font-medium") Your cart is empty
          p(className="text-sm opacity-60") Add something you like and it will show up here.
    else
      fragment
        ul(data-lenis-prevent="" className="min-h-0 flex-1 overflow-y-auto overscroll-contain px-3 divide-y divide-border/50")
          each line in cart.lines key lineKey(line.productId, line.variantId)
            CartLineItem(line={line})
        footer(className="shrink-0 border-t border-border/50 border-dashed px-6 py-5 space-y-3")
          div(className="flex items-center justify-between text-base")
            span(className='font-apro') Subtotal
            span(className="font-adin tabular-nums") #{formatMoney(totals.subtotal)}
          p(className="text-xs opacity-60") Taxes and shipping are calculated at checkout.
          if sync === "error"
            p(role="alert" className="text-sm text-red-600")
              | Couldn't reach the store: #{error}.
              button(type="button" onClick={cartActions.retrySync} className="ml-1 underline") Retry
          elseif sync === "syncing" || sync === "pending"
            p(aria-live="polite" className="text-xs opacity-60") Checking prices and stock…
          RunnerButton(paint="var(--mac-blue)" onClick={checkout} className='w-full bg-foreground! text-white!' label='Checkout')
          if checkoutMessage
            p(role="status" className="text-center text-sm opacity-70") #{checkoutMessage}
