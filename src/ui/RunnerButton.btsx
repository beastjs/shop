import type { ClassValue, OctaneNode} from "octane"
import { cn } from "@/lib/utils";
import {Icon} from "@/lib/icons";

module
  type RunnerProps = {
    label?: string
    paint?: string
    children?: OctaneNode
    className?: ClassValue
    onClick?: (event: MouseEvent) => void
  }
props {className, label='', paint='#1b1b1b', onClick, children}: RunnerProps
button.runner(type="button" className={cn('flex! group/runner opacity-0 group-hover/product:opacity-100 transition-colors duration-600 flex items-center justify-between group-hover/product:px-2', className)} onClick={onClick})
  svg.runner-art(aria-hidden="true" focusable="false" viewBox="0 0 139 85" preserveAspectRatio="none" className='-absolute pointer-events-none -rotate-5 group-hover/product:-rotate-6! transform-all duration-600 scale-235 origin-center')
    path.runner-trace(
      ~ d="M11.4537 22.3596C19.6545 18.1847 27.8552 14.0098 32.8344 11.6445C41.5581 7.50052 10.5956 39.1206 6.13386 45.1438C2.89568 49.5152 3.9942 49.3863 5.19398 49.025C6.39374 48.6638 7.66149 48.0741 16.6566 42.4134C25.6517 36.7528 42.3355 26.0392 51.4912 20.0762C60.6469 14.1132 61.7484 12.4942 62.1378 12.8874C62.5272 13.2807 62.0891 12.7872 55.478 21.125C48.8669 29.4627 36.0752 45.8928 29.3568 54.687C22.6384 63.4811 22.3809 64.1413 22.567 64.3494C22.8772 64.6964 42.6498 51.3989 42.9267 51.203C56.191 41.8144 67.6277 33.8285 81.2663 24.2328C94.9049 14.6371 97.8293 12.9711 99.9697 11.818C100.642 11.4558 105.373 8.65201 104.36 10.5163C103.993 11.1922 103.237 12.3518 94.5861 22.3596C85.935 32.3674 62.1378 61.3918 62.1378 61.3918C62.1378 61.3918 53.0608 71.5223 53.3949 72.0021C53.729 72.482 56.2351 70.9697 67.1706 62.6156C78.1062 54.2615 118.271 23.2751 121.489 24.184C124.707 25.093 95.9878 68.8273 94.5862 74.2402C93.1846 79.6531 124.396 46.4414 134.63 39.8584"
      ~ fill="none"
      ~ stroke={paint}
      ~ stroke-linecap="round"
      ~ stroke-linejoin="round"
      ~ pathLength="1"
      ~ )
  Icon(name='plus' size={12})
  span.runner-label(className='flex items-center justify-center relative z-1 font-sans font-[400] group-hover/runner:tracking-[0.01em] group-hover/runner:text-background dark:group-hover/runner:text-foreground transition-all duration-600') #{label}
  | #{children}
