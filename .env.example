# Convex deployment URL used by local seed scripts.
CONVEX_URL=https://your-deployment.convex.cloud

# Server-only Unsplash app credentials. Never rename these to PUBLIC_*.
UNSPLASH_APP_ID=your_unsplash_app_id
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# Optional proxy base URL. The Rsbuild dev/preview server proxies this path.
PUBLIC_UNSPLASH_API_BASE_URL=/api/unsplash
