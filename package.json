{
  "name": "shop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "bun test tests",
    "typecheck": "tsrx-tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "seed:categories": "convex run categories:seedCategoriesTable",
    "seed:products": "bun scripts/seed-products.ts",
    "icons:build": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts",
    "icons:check": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts --check",
    "update:effect:subtree": "bun scripts/update-effect-subtree.sh"
  },
  "dependencies": {
    "@octanejs/base-ui": "0.1.69",
    "@octanejs/tanstack-router": "^0.3.2",
    "beast-tsrx": "0.16.0",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "effect": "^4.0.6",
    "lenis": "^1.3.27",
    "octane": "0.16.0",
    "tailwind-merge": "^3.6.0",
    "unsplash-js": "^8.0.1"
  },
  "devDependencies": {
    "@beastjs/cli": "0.3.3",
    "@beastjs/devtools": "0.1.23",
    "@beastjs/page-builder": "0.3.0",
    "@octanejs/rsbuild-plugin": "0.1.69",
    "@rsbuild/core": "^2.2.2",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@tsrx/oxc": "0.23.0",
    "@tsrx/typescript-plugin": "0.6.3",
    "@types/node": "^26.2.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
